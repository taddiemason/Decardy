{
  "name": "decardy-website",
  "version": "1.0.0",
  "description": "Modern, mobile-friendly website for Decardy",
  "main": "worker.js",
  "scripts": {
    "build": "mkdir -p dist && cp index.html styles.css script.js dist/ && cp -r images dist/ && cp _headers _redirects dist/ 2>/dev/null; true",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "preview": "wrangler dev --remote",
    "tail": "wrangler tail"
  },
  "keywords": [
    "website",
    "cloudflare",
    "workers",
    "static-site",
    "responsive"
  ],
  "author": "Decardy",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.3.0"
  }
}
