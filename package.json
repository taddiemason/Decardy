{
  "name": "decardy-website",
  "version": "1.0.0",
  "description": "Modern, mobile-friendly website for Decardy",
  "main": "worker.js",
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist/images && cp index.html styles.css script.js _headers _redirects dist/ && cp DecardyFull.png 'decardy logo.png' dist/ && cp -r images/* dist/images/ 2>/dev/null || true",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev --remote",
    "tail": "wrangler tail"
  },
  "keywords": [
    "website",
    "cloudflare",
    "workers",
    "static-site",
    "responsive"
  ],
  "author": "Decardy",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
